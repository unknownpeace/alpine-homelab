# ==============================================================================
# Alpine Homelab Appliance - Configuration Environment (.env)
# ==============================================================================
# Copy this file to config.env to customize your deployment before running:
#   ./homelab.sh install
#
# If config.env does not exist during an interactive terminal install,
# the setup wizard will automatically prompt you and create it for you.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Unified User Credentials
# Used for HTTP Basic Auth (Caddy), Samba Windows shares, and Transmission RPC.
# ------------------------------------------------------------------------------
AUTH_USER="admin"
AUTH_PASS="admin"

# ------------------------------------------------------------------------------
# 2. Network & Domain Settings
# ------------------------------------------------------------------------------
# Base domain suffix for local HTTPS services (e.g., homelab.lan, vault.lan, git.lan)
BASE_DOMAIN="lan"

# System Timezone (standard IANA string)
TIMEZONE="Europe/Moscow"

# Gateway Mode: "yes" configures host as a transparent gateway with IP forwarding
GATEWAY_MODE="yes"

# Bridge Mode: "yes" enclaves physical interface into br0 for router-assigned LXC DHCP
BRIDGE_ENABLE="yes"

# Upstream DNS Resolvers used by sing-box / AdGuard Home
DNS_UPSTREAM_PRIMARY="https://dns.adguard-dns.com/dns-query"
DNS_UPSTREAM_SECONDARY="1.1.1.1"

# Manual Network Overrides (leave empty for automatic detection)
# PHYSICAL_IF="eth0"
# IP_HOST="192.168.1.147"
# CIDR_PREFIX="24"
# DEFAULT_GW="192.168.1.1"

# ------------------------------------------------------------------------------
# 3. Outbound Anti-Censorship & Proxy Configuration (sing-box)
# Options:
#   - "direct" : direct internet access without outbound proxy (default)
#   - Single node share link: vless://..., ss://..., trojan://..., hy2://...
#   - Subscription URL: https://example.com/sub/token?fmt=singbox (or clash/base64)
# ------------------------------------------------------------------------------
PROXY_INPUT="direct"

# ------------------------------------------------------------------------------
# 4. Storage Layout & Alpine Minirootfs Cache
# ------------------------------------------------------------------------------
STORAGE_BASE="/srv/storage"
# Auto-detected per architecture (x86_64 / aarch64) if left empty:
# MINIROOTFS_URL=""

# ------------------------------------------------------------------------------
# 5. Service Stack Feature Flags (yes / no)
# Toggle services to save RAM or tailor the appliance to your specific needs.
# ------------------------------------------------------------------------------
ENABLE_CADDY="yes"         # Reverse Proxy & Local PKI HTTPS (Required for web UI)
ENABLE_DASHBOARD="yes"     # Web Portal Dashboard at https://homelab.lan
ENABLE_SINGBOX="yes"       # DNS filter & Anti-censorship transparent proxy
ENABLE_LXC_MANAGER="yes"   # LXC Container Sandbox Manager & Web Terminal
ENABLE_VAULTWARDEN="yes"   # Bitwarden password manager
ENABLE_FORGEJO="yes"       # Lightweight Git server (disable to save ~150 MB RAM)
ENABLE_CONDUIT="yes"       # Matrix messenger (disable to save ~50 MB RAM)
ENABLE_NAVIDROME="yes"     # Music streaming server (Subsonic API)
ENABLE_TRANSMISSION="yes"  # BitTorrent download daemon
ENABLE_SAMBA="yes"         # Windows / macOS file sharing (SMB & WSDD discovery)
ENABLE_YTDLP="yes"         # Web media downloader (YouTube, VK, etc.)
ENABLE_ADGUARD_HOME="no"   # AdGuard Home visual DNS dashboard & statistics (:3001)
ENABLE_TAILSCALE="no"      # Tailscale Zero-Trust Remote Mesh VPN (Remote access)
